# نسخة اضبطها ثم احفظها باسم .env (مُضيف إلى .gitignore — لا يُرفع إلى GitHub)
# بوابة الإرسال المباشر: الخادم يتصل بمزوّد SMS نيابةً عن المتصفح.
# أبدًا لا تضع هذه القيم داخل ملفات المشروع أو المتصفح.

# (مطلوب) رابط إرسال المزوّد الذي يستقبل POST بصيغة JSON {to, message, text, from, idempotencyKey}
SMS_UPSTREAM_URL=

# اختر ما يناسب مزوّدك (فارغ إذا لا يحتاج)
SMS_API_TOKEN=
SMS_API_KEY=
SMS_API_USER=
SMS_API_PASSWORD=

# رقم/اسم المرسل المعتمد لدى المزوّد (اختياري)
SMS_FROM=

# مهلة الاتصال بالمزوّد بالميلي ثانية (اختياري، الافتراضي 20000)
SMS_TIMEOUT_MS=

# تشغيل الخادم بعد الضبط:
#   SMS_UPSTREAM_URL=... node serve.mjs
# أو عبر ملف .env مع أي محمّل يدعمه (لا يُرفع للمستودع)
